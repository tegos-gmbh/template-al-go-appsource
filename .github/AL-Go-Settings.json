{
  "$schema": "https://raw.githubusercontent.com/microsoft/AL-Go-Actions/v10.1/.Modules/settings.schema.json",
  "type": "AppSource App",
  "templateUrl": "https://github.com/microsoft/AL-Go-AppSource@main",
  "templateSha": "1a5d4484543edae6b26034dd9f1deacdc2708473",
  "CodeReviewAgent": {
    "enabled": true,
    "branches": ["master"],
    "model": "gpt-6.2-sol",
    "leafModel": "gpt-6-luna",
    "excludedAuthors": []
  },
  "customALGoFiles": {
    "filesToInclude": [
      {
          "sourceFolder": ".github/workflows",
          "filter": "pr-description.md",
          "destinationFolder": ".github/workflows"
      },
      {
        "sourceFolder": ".github/skills/al-code-review",
        "filter": "SKILL.md"
      },
      {
        "sourceFolder": ".github/skills/setup-provider-review",
        "filter": "SKILL.md"
      },
      {
        "sourceFolder": ".github/skills/setup-provider-review",
        "filter": "setup-provider-pattern.txt"
      },
      {
        "sourceFolder": ".github/workflows",
        "filter": "copilot-code-review.yml"
      }
    ]
  }
}
